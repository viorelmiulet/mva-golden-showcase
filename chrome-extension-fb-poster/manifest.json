{
  "manifest_version": 3,
  "name": "MVA Facebook Group Poster",
  "version": "1.2.0",
  "description": "Postează automat oferte imobiliare MVA în grupuri Facebook prin coada fb-queue.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://fdpandnzblzvamhsoukt.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/groups/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MVA Facebook Group Poster"
  },
  "options_page": "options.html"
}
