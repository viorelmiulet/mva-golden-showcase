# Long-lived immutable cache for stable, content-stable assets.
# These files don't change without a filename change, so we mark them immutable
# to keep LCP fast on repeat visits and reduce network requests.

/hero-mobile.avif
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/hero-desktop.avif
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/hero-mobile.webp
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/hero-desktop.webp
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/og-image.jpg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/favicon-mva.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon-mva.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Hashed Vite build output — always immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Generic image fallbacks (non-hashed names in /public)
/*.avif
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.jpeg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML must always revalidate so deploys propagate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
